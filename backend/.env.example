PORT=8090
DATABASE_URL=postgres://postgres:your_password@localhost:5432/codeyoung_booking
# Used only by `npm test` (integration tests create their own tables/rows there; never point it at real data).
TEST_DATABASE_URL=postgres://postgres:your_password@localhost:5432/codeyoung_test
FRONTEND_ORIGIN=http://localhost:5173
CLASS_DURATION_MINUTES=60
MEETING_BASE_URL=https://demo.codeyoung.example/class
# Upcoming (not yet finished) trial classes allowed per email address. 0 = unlimited.
MAX_ACTIVE_TRIALS_PER_PARENT=1
# Parents can pick class start times from this local hour to this local hour (inclusive, 0-23).
BOOKABLE_FROM_HOUR=7
BOOKABLE_TO_HOUR=21

# Optional SMTP settings: configure these to send real email. If omitted, emails are printed in the API terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Codeyoung Trial Classes <no-reply@example.com>

# Booking/cancel requests per IP per 15 minutes.
BOOKING_RATE_LIMIT=40
